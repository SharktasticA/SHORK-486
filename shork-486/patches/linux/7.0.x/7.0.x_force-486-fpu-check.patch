diff --git a/arch/x86/kernel/fpu/init.c b/arch/x86/kernel/fpu/init.c
index ff988b9ea..bf5aa9693 100644
--- a/arch/x86/kernel/fpu/init.c
+++ b/arch/x86/kernel/fpu/init.c
@@ -76,10 +76,22 @@ static bool __init fpu__probe_without_cpuid(void)
 
 static void __init fpu__init_system_early_generic(void)
 {
+	bool probe_fpu = !boot_cpu_has(X86_FEATURE_CPUID);
+
 	set_thread_flag(TIF_NEED_FPU_LOAD);
 
-	if (!boot_cpu_has(X86_FEATURE_CPUID) &&
-	    !test_bit(X86_FEATURE_FPU, (unsigned long *)cpu_caps_cleared)) {
+#ifdef CONFIG_X86_32
+	/*
+	 * Patch for SHORK 486:
+	 * i486SX-S and i486SX2 under 86Box report CPUID.FPU=0 with a "487SX"
+	 * installed, so we force a manual FPU probe for family 4 to account.
+	 */
+	if (boot_cpu_data.x86 == 4 && !boot_cpu_has(X86_FEATURE_FPU))
+		probe_fpu = true;
+#endif
+
+	if (probe_fpu &&
+		!test_bit(X86_FEATURE_FPU, (unsigned long *)cpu_caps_cleared)) {
 		if (fpu__probe_without_cpuid())
 			setup_force_cpu_cap(X86_FEATURE_FPU);
 		else
