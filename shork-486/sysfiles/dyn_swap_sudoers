######################################################
## /etc/sudoers.d/dyn_swap                          ##
######################################################
## Backs _dyn_swap() in /etc/profile, letting any   ##
## user use the dynamic swap feature without a      ##
## password.                                        ##
######################################################
## Kali (links.sharktastica.co.uk)                  ##
######################################################



Cmnd_Alias DYNSWAP = /bin/busybox mkdir -p /var/tmp, \
                      /bin/busybox fallocate -l * /var/tmp/.*_dsf.*, \
                      /bin/busybox chmod 600 /var/tmp/.*_dsf.*, \
                      /bin/busybox mkswap /var/tmp/.*_dsf.*, \
                      /bin/busybox swapon /var/tmp/.*_dsf.*, \
                      /bin/busybox swapoff /var/tmp/.*_dsf.*, \
                      /bin/busybox rm -f /var/tmp/.*_dsf.*, \
                      /bin/busybox touch /var/tmp/.dsf_mfk.*, \
                      /bin/busybox rm -f /var/tmp/.dsf_mfk.*, \
                      /bin/busybox rm -f /var/tmp/.dsf_mfk_orig, \
                      /bin/busybox tee /var/tmp/.dsf_mfk_orig, \
                      /bin/busybox tee /proc/sys/vm/min_free_kbytes, \
                      /bin/busybox tee /proc/sys/vm/swappiness
ALL ALL=(root) NOPASSWD: DYNSWAP
