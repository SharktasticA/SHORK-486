NoGrabServer
RestartPreviousState
DecorateTransients
IconifyByUnmapping
RandomPlacement
NoMenuShadows
XorValue 1
NoHighlight
NoTitleHighlight



TitleFont       "6x13"
MenuFont        "6x13"
ResizeFont      "6x13"
IconFont        "6x13"
IconManagerFont "6x13"



Color
{
    BorderColor           "#555555"
    DefaultBackground     "#000000"
    DefaultForeground     "#ffffff"
    TitleBackground       "#0000aa"
    TitleForeground       "#ffffff"
    MenuBackground        "#000000"
    MenuForeground        "#ffffff"
    MenuBorderColor       "#aaaaaa"
    MenuTitleBackground   "#0000aa"
    MenuTitleForeground   "#ffffff"
    IconBackground        "#0000aa"
    IconForeground        "#ffffff"
    IconBorderColor       "#aaaaaa"
    IconManagerBackground "#0000aa"
    IconManagerForeground "#ffffff"
}



ShowIconManager
IconManagerGeometry "@FB_WIDTH@x25+0+0"
IconManagerColumns 6
IconManagerWidth 107



MoveDelta 3
Function "move-or-lower" { f.move f.deltastop f.lower }
Function "move-or-raise" { f.move f.deltastop f.raise }
Function "move-or-iconify" { f.move f.deltastop f.iconify }


Button1 = : root : f.menu "defops"

Button1 = m : window|icon : f.function "move-or-lower"
Button2 = m : window|icon : f.iconify
Button3 = m : window|icon : f.function "move-or-raise"

Button1 = : title : f.function "move-or-raise"
Button2 = : title : f.raiselower

Button1 = : icon : f.function "move-or-iconify"
Button2 = : icon : f.iconify

Button1 = : iconmgr : f.iconify
Button2 = : iconmgr : f.iconify



menu "defops"
{
    "SHORKGUI"          f.title
    "Show Tasklist"     f.showiconmgr
    "Hide Tasklist"     f.hideiconmgr
    "Kill Window"       f.destroy
    "----------------"  f.nop
    "Terminal (80x25)"  f.exec "st -g 80x25 &"
    "Terminal (64x20)"  f.exec "st -g 64x20 &"
    "Terminal (48x15)"  f.exec "st -g 48x15 &"
    "----------------"  f.nop
    "Calculator"        f.exec "xcalc -g 130x170 &"
    "Clock"             f.exec "xclock -g 130x130 -name Clock &"
    "CPU Load"          f.exec "xload -g 130x130 -name \"CPU %\" -fn fixed &"
    "Eyes"              f.exec "xeyes -g 130x85 -name Eyes &"
    "Neko"              f.exec "oneko &"
    "----------------"  f.nop
    "Quit"              f.quit
}



DontIconify
{
    "Tasklist"
    "TWM Icon Manager"
}

NoTitle
{
    "Tasklist"
    "TWM Icon Manager"
}


NoDefaults
RightTitleButton ":iconify" = f.iconify
RightTitleButton ":resize"  = f.resize
RightTitleButton ":delete"  = f.delete
