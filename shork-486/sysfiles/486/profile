######################################################
## /etc/profile                                     ##
######################################################
## System-wide shell profile: core environment      ##
## vars, prompt settings, the dynamic swap OOM-     ##
## protection feature, SHORKSET helper and first-   ##
## boot welcome tip.                                ##
######################################################
## Kali (links.sharktastica.co.uk)                  ##
######################################################



export TERM=linux
export TERMINFO=/usr/share/terminfo
export HOME=/root
export USER=root
export LOGNAME=root
export SHELL=/bin/sh
export PS1='\[\033[0;37m\]\w$ \[\033[0m\]'
export LC_ALL=C

export PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/bin
if [ -d /opt/i486-linux-musl-native/bin ]; then
    PATH="/opt/i486-linux-musl-native/bin:$PATH"
    export CC=gcc
elif [ -x /usr/bin/tcc ]; then
    export CC=tcc
fi
export PATH



# Makes sure min_free_kbytes is at least 1024 and swappiness is 100 so that
# burst memory allocations from dynamic-swapped programs are more likely to
# make it to swap and don't overwhelm the kernel to trigger superfluous OOM 
_mfk_set()
{
    local CURR
    read CURR < /proc/sys/vm/min_free_kbytes
    if ! ls /var/tmp/.dsf_mfk.* >/dev/null 2>&1; then
        $SUDO_BIN sh -c "echo $CURR > /var/tmp/.dsf_mfk_orig"
    fi
    $SUDO_BIN touch "/var/tmp/.dsf_mfk.$$"
    if [ "$CURR" -lt 1024 ]; then
        $SUDO_BIN sh -c "echo 1024 > /proc/sys/vm/min_free_kbytes"
        $SUDO_BIN sh -c "echo 100 > /proc/sys/vm/swappiness"
    fi
}

# Unregisters current proc as a dynamic swap user, and if the last
# dynamic-swapped program running, restores min_free_kbytes and swappiness
# to their original values
_mfk_unset()
{
    local ORIG
    $SUDO_BIN rm -f "/var/tmp/.dsf_mfk.$$"
    if ! ls /var/tmp/.dsf_mfk.* >/dev/null 2>&1; then
        if [ -r /var/tmp/.dsf_mfk_orig ] && read ORIG < /var/tmp/.dsf_mfk_orig; then
            $SUDO_BIN sh -c "echo $ORIG > /proc/sys/vm/min_free_kbytes"
            $SUDO_BIN sh -c "echo 60 > /proc/sys/vm/swappiness"
        fi
        $SUDO_BIN rm -f /var/tmp/.dsf_mfk_orig
    fi
}

# Finds and removes any stale dynamic swap files and MFK files
_reap_stale_swaps()
{
    local F PID REAPED=0
    for F in /var/tmp/.dsf_mfk.* /var/tmp/.*_dsf.*; do
        [ -e "$F" ] || continue
        PID=${F##*.}
        [ -d "/proc/$PID" ] && continue
        case "$F" in
            *_dsf.*) $SUDO_BIN swapoff "$F" 2>/dev/null ;;
        esac
        $SUDO_BIN rm -f "$F"
        REAPED=1
    done
    [ "$REAPED" -eq 1 ] && _mfk_unset
}

# Wraps launching a program with creating a <=48MiB swap file for it to help
# prevent the kernel from OOM-killing it when the system runs out of
# physical memory
_dyn_swap()
{
    local BIN_PATH="$1"
    shift

    if [ ! -x "$BIN_PATH" ]; then
        printf "${SHELL}: %s: not found\n" "$(basename "$BIN_PATH")"
        return 127
    fi

    # Only proceed if dynamic swap is enabled in shorkset.conf
    DYN_SWAP_ENABLED=0
    [ -r /etc/shorkset.conf ] && . /etc/shorkset.conf
    if [ "$DYN_SWAP_ENABLED" != "1" ]; then
        "$BIN_PATH" "$@"
        return $?
    fi

    # Make sure we don't create swap if something simple like help or version
    # is requested
    local ARG
    for ARG in "$@"; do
        case "$ARG" in
            --help|-h|--version|-v|-V|-\?)
                "$BIN_PATH" "$@"
                return $?
                ;;
        esac
    done

    # If not root, we need to determine if we have sudo so regular users can
    # dynamic swap
    local SUDO_BIN=""
    if [ "$(whoami)" != "root" ]; then
        if [ -x /usr/bin/sudo ]; then
            SUDO_BIN="sudo -n /bin/busybox"
        else
            "$BIN_PATH" "$@"
            return $?
        fi
    fi

    _reap_stale_swaps

    local SWAP_DIR="/var/tmp"
    local SWAP_PATH="${SWAP_DIR}/.$(basename "$BIN_PATH")_dsf.$$"
    local TARGET_B=$((48 * 1048576))

    # If target is more than half of root free space, set it to quater of
    # said space
    local ROOT_AVAIL_B=$(df -B1 / 2>/dev/null | awk 'NR==2 {print $4}')
    if [ -n "$ROOT_AVAIL_B" ] && [ "$ROOT_AVAIL_B" -gt 0 ]; then
        if [ "$TARGET_B" -gt $((ROOT_AVAIL_B / 2)) ]; then
            TARGET_B=$((ROOT_AVAIL_B / 4))
        fi
    fi

    local TARGET_MB=$((TARGET_B / 1048576))
    [ "$TARGET_MB" -lt 1 ] && TARGET_MB=1

    local SWAP_OK=0
    if [ ! -d "${SWAP_DIR}" ]; then
        $SUDO_BIN mkdir -p "${SWAP_DIR}"
    fi
    if $SUDO_BIN fallocate -l "${TARGET_MB}M" "$SWAP_PATH" 2>/dev/null \
        && $SUDO_BIN chmod 600 "$SWAP_PATH" \
        && $SUDO_BIN mkswap "$SWAP_PATH" >/dev/null 2>&1 \
        && $SUDO_BIN swapon "$SWAP_PATH" 2>/dev/null; then
        SWAP_OK=1
    fi

    _swap_cleanup()
    {
        _mfk_unset
        if [ "$SWAP_OK" = "1" ]; then
            $SUDO_BIN swapoff "$SWAP_PATH" 2>/dev/null
        fi
        $SUDO_BIN rm -f "$SWAP_PATH"
        trap - EXIT INT TERM HUP
    }
    trap _swap_cleanup EXIT INT TERM HUP
    _mfk_set

    "$BIN_PATH" "$@"
    local RET=$?

    _swap_cleanup
    return $RET
}



# Ensures SHORKSET is ran as root and exits if it needs to respawn terminal
shorkset()
{
    local ret
    # Only proceed if user is root
    if [ "$(whoami)" != "root" ]; then
        if which sudo >/dev/null 2>&1; then
            sudo /usr/libexec/shorkset "$@" || return
        else
            printf "SHORKSET must be ran whilst logged in as root, via \033[0;1;31msu\033[0m, or with \033[0;1;31msudo\033[0m\n" >&2
            return 1
        fi
    else
        /usr/libexec/shorkset "$@"
    fi
    ret=$?

    [ "$ret" -eq 3 ] && exit 0
    return "$ret"
}



# Show first-boot welcome tip
if [ ! -f /etc/.past_first_boot ] && [ "$(tty)" = "/dev/tty1" ]; then
    TERM_WIDTH=$(stty size 2>/dev/null | cut -d' ' -f2)

    # Base message
    TIP="Welcome! Please check out shorkhelp to learn more about SHORK and get started."

    # Public Test build disclaimer
    if grep -q "PT" /etc/issue 2>/dev/null; then
        TIP="${TIP} This is a pre-release build for testing purposes only. See shorkhelp's \"Public Test 1\" guide for more information."
    fi

    ESC=$(printf '\033')
    TIP_FOLDED=$(printf "%s\n" "$TIP" | fold -s -w "$TERM_WIDTH" | sed "s/shorkhelp/${ESC}[32mshorkhelp${ESC}[0m/g")
    printf "%s\n" "$TIP_FOLDED"

    # Padding specific for single-user use
    if [ ! -d /home ]; then
        printf "\n"
    fi

    echo "1" > /etc/.past_first_boot
fi
