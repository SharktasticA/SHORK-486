#!/bin/sh

# Provides a systemd-style log message
log()
{
    MSG="$1"
    UP=0
    [ -r /proc/uptime ] && IFS=' ' read UP _ < /proc/uptime
    printf "[%10s] %s\n" "$UP" "$MSG"
}

# Mount core file systems
log "Mounting /proc"
mount -t proc  proc  /proc
log "Mounting /sys"
mount -t sysfs sysfs /sys

# Disable watermark boosting to help avoid OOM killer
log "Disabling watermark boosting"
echo 0 > /proc/sys/vm/watermark_boost_factor

# Lower # of RAM the kernel tries to keep free avoid OOM killer
read MFK_DEFAULT < /proc/sys/vm/min_free_kbytes
if [ "$MFK_DEFAULT" -gt 1024 ] 2>/dev/null; then
    log "Lowering min_free_kbytes: $MFK_DEFAULT to 1024"
    echo 1024 > /proc/sys/vm/min_free_kbytes
fi

# Mount devpts for pseudo-terminals
log "Mounting /dev/pts"
mkdir -p /dev/pts
mount -t devpts -o gid=5,mode=620,ptmxmode=666 devpts /dev/pts

# Required device nodes
log "Creating required device nodes"
[ -c /dev/ptmx ] || mknod -m 666 /dev/ptmx c 5 2
[ -c /dev/tty ]  || mknod -m 666 /dev/tty  c 5 0
[ -c /dev/tty0 ] || mknod -m 620 /dev/tty0 c 4 0
[ -c /dev/tty1 ] || mknod -m 620 /dev/tty1 c 4 1

# Set hostname
if [ -r /etc/hostname ]; then
    HOSTNAME="$(cat /etc/hostname)"
    log "Setting hostname: $HOSTNAME"
    hostname "$HOSTNAME"
fi

export ENV=/etc/profile

# Prepare to show the welcome banner
log "Showing welcome banner"
clear

# Show welcome banner, OS name and author name
if [ -f /banners/welcome ]; then
    TERM_WIDTH=$(stty size 2>/dev/null | awk '{print $2}')
    [ -z "$TERM_WIDTH" ] && TERM_WIDTH=80

    BUFFER=""
    if [ "$TERM_WIDTH" -gt 40 ]; then
        # Print top border
        BUFFER="${BUFFER}$(printf "%*s" "$TERM_WIDTH" '')"

        # Print banner
        BUFFER="${BUFFER}$(cat /banners/welcome)"

        # Show OS name
        OS="@DIST@"
        TOTAL_PAD=$((TERM_WIDTH - ${#OS}))
        RIGHT_PAD=$((TOTAL_PAD / 2))
        LEFT_PAD=$((TOTAL_PAD - RIGHT_PAD))
        BUFFER="${BUFFER}$(printf "%*s%s%*s\n" "$LEFT_PAD" '' "$OS" "$RIGHT_PAD" '')"

        # Show author
        AUTHOR="Kali (links.sharktastica.co.uk)"
        TOTAL_PAD=$((TERM_WIDTH - ${#AUTHOR}))
        RIGHT_PAD=$((TOTAL_PAD / 2))
        LEFT_PAD=$((TOTAL_PAD - RIGHT_PAD))
        BUFFER="${BUFFER}$(printf "%*s%s%*s\n" "$LEFT_PAD" '' "$AUTHOR" "$RIGHT_PAD" '')"

        # Print bottom border
        BUFFER="${BUFFER}$(printf "%*s" "$TERM_WIDTH" '')"
    fi

    # Set terminal to white on blue
    printf "\x1b[37;44m"
    # Print buffer
    printf "%b" "$BUFFER"
    # Reset colour
    printf "\x1b[0m"
fi

printf "\n\n"
