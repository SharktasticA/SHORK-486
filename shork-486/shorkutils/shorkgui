#!/bin/sh

if [ -f /etc/shorkset.conf ]; then
    . /etc/shorkset.conf
else
    FONT_COL_NAME="white"
    FONT_COL_ANSI="0;37"
fi

TERM_WIDTH=$(stty size 2>/dev/null | cut -d' ' -f2)

if [ ! -e /dev/fb0 ]; then
    printf "ERROR: No framebuffer device has been found. Please ensure your kernel was built with framebuffer support in the after-build report, or that either the \"force vga16fb\" driver option or a VBE-style resolution is selected in \033[32mshorkset\033[${FONT_COL_ANSI}m.\n" | fold -s -w "$TERM_WIDTH"
    exit 1
fi

ORIG_VT=$(tty 2>/dev/null | sed -n 's|^/dev/tty\([0-9][0-9]*\)$|\1|p')
[ -z "$ORIG_VT" ] && ORIG_VT=1

cleanup()
{
    if [ -n "$X_PID" ]; then
        kill "$X_PID" 2>/dev/null
        wait "$X_PID" 2>/dev/null
    fi
    rm -f /tmp/shorkgui.twmrc 2>/dev/null
    chvt "$ORIG_VT" 2>/dev/null
}
trap cleanup EXIT INT TERM



FB_WIDTH=$(cat /sys/class/graphics/fb0/virtual_size | cut -d',' -f1)
FB_BPP=$(cat /sys/class/graphics/fb0/bits_per_pixel 2>/dev/null)
case "$FB_BPP" in
    4)  XOR_VALUE=1 ;;
    15) XOR_VALUE=32767 ;;
    16) XOR_VALUE=65535 ;;
    *)  XOR_VALUE=16777215 ;;
esac
FONT_DIR="/usr/lib/X11/fonts/misc"
MODE="dark"

for arg in "$@"; do
    case "$arg" in
        --light|--passive)
            MODE="light"
            ;;
    esac
done

export DISPLAY=:0
export FONTCONFIG_PATH=/etc/fonts
export FONTCONFIG_FILE=/etc/fonts/fonts.conf
export XLOCALEDIR=/usr/share/X11/locale

Xfbdev :0 vt1 -extension XFree86-Bigfont -mouse /dev/input/mice -mouse /dev/ttyS0 -fp $FONT_DIR 2>/tmp/xlog &
X_PID=$!

MAX_RETRIES=10
COUNT=0
while ! xset -q >/dev/null 2>&1; do
    COUNT=$((COUNT + 1))
    if [ $COUNT -ge $MAX_RETRIES ]; then
        printf "\nERROR: Xfbdev failed to respond after 5 seconds.\n" | fold -s -w "$TERM_WIDTH"
        exit 1
    elif ! kill -0 $X_PID 2>/dev/null; then
        printf "\nERROR: Xfbdev exited unexpectedly.\n" | fold -s -w "$TERM_WIDTH"
        exit 1
    fi
    sleep 0.5
done

if [ $MODE == "light" ]; then 
    xli -onroot -center -border white -quiet /usr/share/backgrounds/shork_640x480_invert.png
    sed -e "s/@FB_WIDTH@/$FB_WIDTH/g" \
        -e "s/^XorValue 1\$/XorValue $XOR_VALUE/" \
        /usr/share/X11/twm/light.twmrc > /tmp/shorkgui.twmrc
else
    xli -onroot -center -border black -quiet /usr/share/backgrounds/shork_640x480.png
    sed -e "s/@FB_WIDTH@/$FB_WIDTH/g" \
        -e "s/^XorValue 1\$/XorValue $XOR_VALUE/" \
        /usr/share/X11/twm/dark.twmrc > /tmp/shorkgui.twmrc
fi

sleep 0.5
twm -f /tmp/shorkgui.twmrc 2>/dev/null
